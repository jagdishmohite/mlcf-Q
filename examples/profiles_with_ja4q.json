[
  {
    "name": "Chrome-124-Windows-QUIC",
    "description": "Chromium ~124, Windows, QUIC/HTTP-3 enabled, PQ hybrid key share rolled out",
    "expected": {
      "transport": {
        "quic_version": "1",
        "idle_timeout_ms": [
          20000,
          30000
        ],
        "initial_max_data": [
          10000000,
          30000000
        ],
        "initial_max_streams_bidi": [
          90,
          110
        ],
        "active_connection_id_limit": [
          2,
          4
        ],
        "disable_active_migration": false
      },
      "handshake": {
        "alpn_contains": "h3",
        "cipher_suites_any_of": [
          "TLS_AES_128_GCM_SHA256",
          "TLS_CHACHA20_POLY1305_SHA256"
        ],
        "pq_key_share_expected": true,
        "ja4q_reference": "chrome-ja4q"
      },
      "http3": {
        "qpack_max_table_capacity": [
          4096,
          65536
        ],
        "requires_settings": [
          "QPACK_MAX_TABLE_CAPACITY"
        ]
      },
      "behavioral": {
        "min_burstiness": 0.15,
        "zero_rtt_typical": true
      }
    }
  },
